<?xml version="1.0" encoding="UTF-8"?>
<!--<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">-->

<suite name="DMVTEK-Retail Application Test Sanity Suite" verbose="2"
	thread-count="4" parallel="tests">

	<listeners>
		<listener
			class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<!--		<listener-->
		<!--			class-name="com.qa.retail.listeners.AnnotationTransformer" />-->
		<listener
			class-name="com.qa.retail.listeners.TestAllureListener" />
	</listeners>


	<test name="Login Page Test">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.qa.retail.tests.LoginPageTest" />
		</classes>
	</test>


</suite>